[Unit]
Description=Aurora i3pro expired upload cleanup
After=i3pro.service

[Service]
Type=oneshot
User=i3pro
Group=i3pro
WorkingDirectory=/opt/aurora-i3pro-lowmem
ExecStart=/opt/i3pro/.venv/bin/python -B /opt/aurora-i3pro-lowmem/retention.py --run-scheduled
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/i3pro
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=64M
CPUQuota=10%
TimeoutStartSec=120
