# 七牛 OSS 部署凭证模板
#
# 用法：复制为 .env.deploy 并填入真实值。注意是 .env.deploy，不是本文件。
#   cp .env.deploy.example .env.deploy
#
# 真实密钥只写进 .env.deploy（已被 .gitignore 忽略）。
# 本文件是模板，会提交到版本库，务必保持占位符原样。
# CI/CD 环境请直接配置同名环境变量（Secrets），不要放文件。

# 七牛密钥管理页获取：https://portal.qiniu.com/user/key
QINIU_ACCESS_KEY=your_access_key
QINIU_SECRET_KEY=your_secret_key

# 存放静态资源的存储空间名称
QINIU_BUCKET=aurora-racing

# CDN 加速域名，仅 --refresh 刷新缓存时需要
QINIU_CDN_DOMAIN=https://cdn.aurora-racing.com
