# 七牛云 CDN 配置
# 复制此文件为 .env.deploy 并填入实际值（.env.deploy 已在 .gitignore 中，不会提交到仓库）

# 七牛访问密钥（在七牛云控制台 - 密钥管理中获取）
QINIU_ACCESS_KEY=your_access_key_here
QINIU_SECRET_KEY=your_secret_key_here

# 七牛存储空间名称
QINIU_BUCKET=your_bucket_name

# CDN 加速域名（必须以 https:// 或 http:// 开头，结尾不要斜杠）
VITE_CDN_URL=https://cdn.your-domain.com
QINIU_CDN_DOMAIN=https://cdn.your-domain.com
